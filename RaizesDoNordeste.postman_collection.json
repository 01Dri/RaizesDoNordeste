									"if (jsonData.data && jsonData.data.publicId) {",
									"    pm.collectionVariables.set(\"orderId\", jsonData.data.publicId);",
									"    console.log(\"PublicId do pedido criado salvo: \" + jsonData.data.publicId);",
									"} else if (jsonData.publicId) {",
