				{
					"name": "Criar Pedido com Sucesso (Canal Válido TOTEM)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.publicId) {",
									"    pm.collectionVariables.set(\"orderId\", jsonData.data.publicId);",
									"    console.log(\"PublicId do pedido criado salvo: \" + jsonData.data.publicId);",
									"} else if (jsonData.publicId) {",
									"    pm.collectionVariables.set(\"orderId\", jsonData.publicId);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
